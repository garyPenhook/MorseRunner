#!/usr/bin/env sh
# Launch the full native engine from its data directory. It needs the bundled
# contest and callsign files beside the executable, not beside this wrapper.
#
# Current Lazarus GTK3 releases can print harmless widget/compositor diagnostics
# on some desktop themes. Keep normal launches quiet while retaining those
# diagnostics in the XDG state directory. Set MORSERUNNER_DEBUG=1 to send them
# to the terminal instead.
set -eu
WRAPPER_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SOURCE_ROOT=$(CDPATH= cd -- "$WRAPPER_DIR/../.." && pwd)
INSTALL_ROOT=$(CDPATH= cd -- "$WRAPPER_DIR/.." && pwd)
SOURCE_ENGINE="$SOURCE_ROOT/native/engine/MorseRunner"
INSTALLED_ENGINE="$INSTALL_ROOT/lib/morserunner/MorseRunner"

if [ -x "$SOURCE_ENGINE" ]; then
  ENGINE="$SOURCE_ENGINE"
else
  ENGINE="$INSTALLED_ENGINE"
fi

if [ "${MORSERUNNER_DEBUG:-}" = "1" ]; then
  exec "$ENGINE" "$@"
fi

STATE_ROOT=${XDG_STATE_HOME:-"${HOME:-/tmp}/.local/state"}
LOG_DIR="$STATE_ROOT/morserunner"
mkdir -p "$LOG_DIR"
exec "$ENGINE" "$@" 2>>"$LOG_DIR/gtk3-runtime.log"
